{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "plugins": [
    "react",
    "react-hooks"
  ],
  "rules": {
    "no-undef": "error",
    "no-redeclare": "error",
    "no-dupe-keys": "error",
    "no-unreachable": "warn",
    "react/jsx-no-undef": "error",
    "react/jsx-uses-vars": "error",
    "no-use-before-define": [
      "warn",
      {
        "functions": false,
        "classes": true,
        "variables": false
      }
    ],
    "react-hooks/exhaustive-deps": "off",
    "react-hooks/rules-of-hooks": "error"
  }
}